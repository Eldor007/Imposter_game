[Unit]
Description=Telegram Imposter game bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=imposter
WorkingDirectory=/opt/imposter-bot
EnvironmentFile=/etc/imposter-bot.env
ExecStart=/usr/bin/python3 /opt/imposter-bot/bot.py
Environment=STATE_FILE=/var/lib/imposter-bot/state.json
StateDirectory=imposter-bot
StateDirectoryMode=0700
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
MemoryMax=128M
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
